import dotenv from "dotenv";
import { createClient } from "@supabase/supabase-js";

dotenv.config({ path: ".env.local" });

const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL!;
const serviceRoleKey = process.env.SUPABASE_SERVICE_ROLE_KEY!;

const supabase = createClient(supabaseUrl, serviceRoleKey);

const API_BASE = "https://api.tcgdex.net/v2";
const LANGUAGE = "ja";

const sleep = (ms: number) =>
  new Promise((resolve) => setTimeout(resolve, ms));

async function fetchWithRetry(
  url: string,
  attempts = 5
): Promise<any> {
  let lastError: unknown;

  for (let attempt = 1; attempt <= attempts; attempt++) {
    try {
      const response = await fetch(url);

      if (response.ok) {
        return await response.json();
      }

      const retryable = [429, 502, 503, 504].includes(
        response.status
      );

      if (!retryable) {
        throw new Error(
          `HTTP ${response.status} pour ${url}`
        );
      }

      const retryAfter =
        response.headers.get("retry-after");

      const delay = retryAfter
        ? Number(retryAfter) * 1000
        : Math.min(1000 * 2 ** (attempt - 1), 15000);

      console.log(
        `⚠️ HTTP ${response.status} — nouvelle tentative dans ${delay} ms`
      );

      await sleep(delay);
    } catch (error) {
      lastError = error;

      if (attempt === attempts) {
        break;
      }

      const delay = Math.min(
        1000 * 2 ** (attempt - 1),
        15000
      );

      console.log(
        `⚠️ Erreur réseau — nouvelle tentative dans ${delay} ms`
      );

      await sleep(delay);
    }
  }

  throw lastError;
}

async function getExistingCardSourceIds(): Promise<Set<string>> {
  const result = new Set<string>();

  let from = 0;
  const pageSize = 1000;

  while (true) {
    const { data, error } = await supabase
      .from("cards")
      .select("source_id")
      .eq("source", "tcgdex")
      .eq("language", "JP")
      .range(from, from + pageSize - 1);

    if (error) {
      throw new Error(
        `Erreur récupération cartes existantes : ${error.message}`
      );
    }

    for (const row of data ?? []) {
      if (row.source_id) {
        result.add(row.source_id);
      }
    }

    if (!data || data.length < pageSize) {
      break;
    }

    from += pageSize;
  }

  return result;
}

async function getSetCardIds(
  setCode: string
): Promise<any[]> {
  return fetchWithRetry(
    `${API_BASE}/${LANGUAGE}/sets/${encodeURIComponent(
      setCode
    )}`
  );
}

async function main() {
  console.log("\n======================================");
  console.log(" SYNC TCGDEX — JAPONAIS");
  console.log("======================================\n");

  // --------------------------------------------------
  // 1. Récupération des sets TCGdex
  // --------------------------------------------------

  console.log("📡 Récupération des sets japonais...");

  const allSets = await fetchWithRetry(
    `${API_BASE}/${LANGUAGE}/sets`
  );

  if (!Array.isArray(allSets)) {
    throw new Error(
      "Réponse inattendue de TCGdex pour /sets"
    );
  }

  // --------------------------------------------------
  // 2. Filtrage
  // --------------------------------------------------

  const validSets = allSets.filter((set: any) => {
    const code = String(set.id ?? "");

    // Les CS... sont des entrées anormales/dupliquées
    if (code.startsWith("CS")) {
      return false;
    }

    // On ignore les sets sans cartes
    if (!set.cardCount || set.cardCount.total <= 0) {
      return false;
    }

    return true;
  });

  console.log(
    `Sets TCGdex trouvés : ${allSets.length}`
  );

  console.log(
    `Sets retenus : ${validSets.length}`
  );

  console.log(
    `Sets exclus : ${allSets.length - validSets.length}\n`
  );

  // --------------------------------------------------
  // 3. Cartes déjà présentes
  // --------------------------------------------------

  console.log(
    "🔎 Vérification des cartes JP déjà présentes..."
  );

  const existingCardIds =
    await getExistingCardSourceIds();

  console.log(
    `Cartes JP déjà présentes : ${existingCardIds.size}\n`
  );

  // --------------------------------------------------
  // 4. Statistiques
  // --------------------------------------------------

  let setsCreatedOrUpdated = 0;
  let cardsImported = 0;
  let cardsAlreadyPresent = 0;
  let errors = 0;

  // --------------------------------------------------
  // 5. Traitement des sets
  // --------------------------------------------------

  for (let i = 0; i < validSets.length; i++) {
    const set = validSets[i];

    const setCode = String(set.id);
    const setName = set.name ?? setCode;

    console.log(
      `\n[${i + 1}/${validSets.length}] ${setCode} — ${setName}`
    );

    // ------------------------------------------------
    // 5A. Upsert du set
    // ------------------------------------------------

    const { data: dbSet, error: setError } =
      await supabase
        .from("sets")
        .upsert(
          {
            source: "tcgdex",
            source_id: setCode,
            name: setName,
            series: set.series ?? null,
            language: "JP",
            region: "JP",
            code: setCode,
            release_date: set.releaseDate ?? null,
            total_cards:
              set.cardCount?.total ??
              set.cardCount?.official ??
              null,
            logo_url: set.logo ?? null,
            symbol_url: set.symbol ?? null,
            product_type: "tcg",
          },
          {
            onConflict: "source,source_id",
          }
        )
        .select("id")
        .single();

    if (setError || !dbSet) {
      console.error(
        `❌ Erreur set ${setCode}:`,
        setError?.message
      );

      errors++;
      continue;
    }

    setsCreatedOrUpdated++;

    // ------------------------------------------------
    // 5B. Récupération des cartes du set
    // ------------------------------------------------

    let cards: any[];

    try {
      cards = await getSetCardIds(setCode);
    } catch (error) {
      console.error(
        `❌ Impossible de récupérer les cartes de ${setCode}:`,
        error
      );

      errors++;
      continue;
    }

    if (!Array.isArray(cards)) {
      console.error(
        `❌ Réponse inattendue pour le set ${setCode}`
      );

      errors++;
      continue;
    }

    console.log(
      `   Cartes TCGdex : ${cards.length}`
    );

    // ------------------------------------------------
    // 5C. Cartes manquantes uniquement
    // ------------------------------------------------

    const missingCards = cards.filter((card: any) => {
      const sourceId = `${setCode}-${card.localId}`;

      return !existingCardIds.has(sourceId);
    });

    cardsAlreadyPresent +=
      cards.length - missingCards.length;

    if (missingCards.length === 0) {
      console.log(
        "   ✓ Toutes les cartes sont déjà présentes."
      );

      continue;
    }

    console.log(
      `   À importer : ${missingCards.length}`
    );

    // ------------------------------------------------
    // 5D. Import des cartes
    // ------------------------------------------------

    const rows = [];

    for (const card of missingCards) {
      const sourceId = `${setCode}-${card.localId}`;

      rows.push({
        set_id: dbSet.id,
        source: "tcgdex",
        source_id: sourceId,

        local_id: card.localId ?? null,
        number:
          card.localId ??
          card.number ??
          null,

        name: card.name ?? "Nom inconnu",

        language: "JP",

        rarity: card.rarity ?? null,

        variant_type:
          card.variants?.normal === true &&
          card.variants?.reverse === true
            ? "normal+reverse"
            : card.variants?.reverse === true
            ? "reverse"
            : "normal",

        category: card.category ?? null,

        hp: card.hp ?? null,

        types: card.types ?? null,

        variants: card.variants ?? null,

        image_small:
          card.image
            ? `${card.image}/low.webp`
            : null,

        image_large:
          card.image
            ? `${card.image}/high.webp`
            : null,

        regulation_mark:
          card.regulationMark ?? null,

        dex_ids:
          card.dexId ?? null,
      });
    }

    // ------------------------------------------------
    // 5E. Insertion par lots
    // ------------------------------------------------

    const batchSize = 100;

    for (
      let start = 0;
      start < rows.length;
      start += batchSize
    ) {
      const batch = rows.slice(
        start,
        start + batchSize
      );

      const { error: insertError } =
        await supabase
          .from("cards")
          .insert(batch);

      if (insertError) {
        console.error(
          `❌ Erreur insertion ${setCode} (${start}-${start + batch.length - 1}):`,
          insertError.message
        );

        errors++;
        continue;
      }

      cardsImported += batch.length;

      for (const row of batch) {
        existingCardIds.add(row.source_id);
      }

      console.log(
        `   ✓ ${Math.min(
          start + batch.length,
          rows.length
        )}/${rows.length}`
      );
    }
  }

  // --------------------------------------------------
  // 6. Résumé
  // --------------------------------------------------

  console.log("\n======================================");
  console.log(" RÉSUMÉ");
  console.log("======================================\n");

  console.log(
    `Sets créés / mis à jour : ${setsCreatedOrUpdated}`
  );

  console.log(
    `Cartes déjà présentes   : ${cardsAlreadyPresent}`
  );

  console.log(
    `Cartes importées        : ${cardsImported}`
  );

  console.log(
    `Erreurs                 : ${errors}`
  );

  console.log("\n======================================");

  if (errors === 0) {
    console.log("🟢 SYNCHRONISATION TERMINÉE");
  } else {
    console.log(
      "🟠 SYNCHRONISATION TERMINÉE AVEC DES ERREURS"
    );
  }

  console.log("======================================\n");
}

main().catch((error) => {
  console.error("\n🔴 ERREUR FATALE :", error);
  process.exit(1);
});